# ---- core ----
NODE_ENV=development
PORT=5000
APP_NAME=Technical Workers
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/smartserve

# ---- auth (use long random strings; required in production) ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# ---- deployment behind proxies ----
# 1 = API directly behind Render. 2 = Vercel proxies /api to Render.
TRUST_PROXY_HOPS=1
# lax works when the frontend and API share one site. Use none only for separate sites.
COOKIE_SAMESITE=lax

# ---- payments (Razorpay test keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# ---- email (leave SMTP_HOST empty to print emails in the terminal instead) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Technical Workers <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=

# ---- used only by: npm run seed:admin ----
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123